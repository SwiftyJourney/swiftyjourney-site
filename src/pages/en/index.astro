---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPortfolio from "../../components/HeroPortfolio.astro";
import ProblemSolver from "../../components/ProblemSolver.astro";
import SkillStrip from "../../components/SkillStrip.astro";
import ProjectsGrid from "../../components/ProjectsGrid.astro";

const altHref = "/es/";
---

<BaseLayout
	lang="en"
	altHref={altHref}
	altLang="es"
	title="Swifty Journey — Juan Dorado"
	description="Mexican iOS/Software Engineer. Swift & SwiftUI."
>
	<HeroPortfolio
		title="Frontend iOS Engineer"
		subtitle="I build maintainable, testable iOS apps with clean architecture, analytics and CI/CD."
		ctas={[
			{ label: "See my work", href: "#projects" },
			{ label: "Download CV", href: "/JuanDorado-CV.pdf", kind: "primary" },
			{ label: "Read the blog", href: "https://blog.swiftyjourney.com" },
		]}
	/>

	<ProblemSolver
		title="Problem solver <coder>"
		subtitle="iOS engineer with 10+ years building maintainable, testable apps—from UIKit to SwiftUI—with clean architecture and continuous delivery."
		items={[
			{
				text: "Clean Architecture, SPM modularization, and testability focus.",
			},
			{
				text: "From UIKit to SwiftUI; closures and Structured Concurrency.",
			},
			{
				text: "Observability (crashes, logs, metrics).",
			},
			{ text: "CI/CD: pipelines, automation, review apps." },
			{
				text: "Apple Developer Platform: certificates, provisioning, App Store releases.",
			},
			{
				text: "Mentoring and iOS interviewing; Essential Developer community.",
			},
			{
				text: "Version control with Git, terminal‑first workflow.",
			},
		]}
		photoSrc="/hero/taylor_wave.png"
	/>

	<SkillStrip
		skills={[
			{
				icon: "mdi:design",
				title: "Architecture",
				desc: "Clean Architecture, SOLID, TDD, layered boundaries.",
			},
			{
				icon: "mdi:source-branch",
				title: "Modularization",
				desc: "SPM modules, clear boundaries and dependencies.",
			},
			{
				icon: "mdi:gesture-tap-button",
				title: "SwiftUI & Concurrency",
				desc: "From UIKit to SwiftUI; async/await, actors, isolation.",
			},
			{
				icon: "mdi:chart-box-outline",
				title: "Analytics & Observability",
				desc: "Adobe Analytics & DataDog: events, traces, alerts.",
			},
			{
				icon: "mdi:cloud-sync-outline",
				title: "CI/CD",
				desc: "GitHub Actions; Xcode Cloud when needed.",
			},
			{
				icon: "mdi:terminal",
				title: "Git Terminal‑first",
				desc: "Git workflows; CLI‑driven automation.",
			},
		]}
	/>

	<ProjectsGrid
		projects={[
			{
				title: "OneDarkTheme",
				desc: "One Dark theme for Xcode.",
				tags: ["Swift", "Xcode"],
				href: "https://github.com/jfdoradotr/OneDarkTheme",
			},
			{
				title: "XCSnippets",
				desc: "Xcode snippets via SPM.",
				tags: ["Swift", "Productivity"],
				href: "https://github.com/jfdoradotr/XCSnippets",
			},
			{
				title: "I-VIPER",
				desc: "Template to bootstrap VIPER.",
				tags: ["Makefile", "Architecture"],
				href: "https://github.com/jfdoradotr/I-VIPER",
			},
		]}
	/>
</BaseLayout>

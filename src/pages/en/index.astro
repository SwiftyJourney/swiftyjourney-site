---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPortfolio from "../../components/HeroPortfolio.astro";
import FeaturedArticles from "../../components/FeaturedArticles.astro";
import MiniAbout from "../../components/MiniAbout.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import { featuredArticles } from "../../data/featured-articles";
---

<BaseLayout
  lang="en"
  title="Swifty Journey — Juan Dorado"
  description="Senior iOS Engineer. Swift, SwiftUI, Clean Architecture."
  seoTitle="Juan Dorado — Senior iOS Engineer"
  seoDescription="I build maintainable, testable iOS apps with Swift and SwiftUI — and write about what I learn along the way."
  seoType="profile"
>
  <HeroPortfolio
    titleLead="Master"
    titleAccent="Swift"
    titleTail="Build real iOS apps."
    subtitle="I share what I learn from 11+ years shipping iOS apps — clean architecture, SwiftUI, and real-world engineering, in plain language."
    primaryCta={{ label: "Read the blog", href: "https://blog.swiftyjourney.com/en/", external: true }}
    ghostCta={{ label: "About me", href: "/en/about/" }}
  />

  <FeaturedArticles
    eyebrow="Latest articles"
    title="From the blog"
    articles={featuredArticles.en}
    moreLabel="Read all articles"
    moreHref="https://blog.swiftyjourney.com/en/"
  />

  <MiniAbout
    heading="Hi, I'm Juan — Senior iOS Engineer from Mexico."
    body="11+ years shipping iOS apps, from UIKit to SwiftUI, from solo projects to leading teams. I write to help other engineers reason through the tradeoffs I wish someone had shown me."
    ctaLabel="More about me"
    ctaHref="/en/about/"
  />

  <FinalCTA
    heading="Want to learn Swift the right way?"
    body="Clear writing, strong opinions, working code."
    ctaLabel="Read the blog"
    ctaHref="https://blog.swiftyjourney.com/en/"
    external
  />
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPortfolio from "../../components/HeroPortfolio.astro";
import ProblemSolver from "../../components/ProblemSolver.astro";
import SkillStrip from "../../components/SkillStrip.astro";
import ProjectsGrid from "../../components/ProjectsGrid.astro";
import TechBadges from "../../components/TechBadges.astro";
import PartnersStrip from "../../components/PartnersStrip.astro";

const altHref = "/es/";
---

<BaseLayout
	lang="en"
	altHref={altHref}
	altLang="es"
	title="Swifty Journey — Juan Dorado"
	description="Mexican iOS Engineer. Swift & SwiftUI."
>
	<HeroPortfolio
		title="iOS Engineer"
		subtitle="I build maintainable, testable iOS apps with clean architecture, analytics, and CI/CD."
		ctas={[
			{ label: "See work", href: "#projects" },
			{ label: "Download CV", href: "/JuanDorado-CV.pdf", kind: "primary" },
			{ label: "Go to blog", href: "https://blog.swiftyjourney.com" },
		]}
	/>

	<ProblemSolver
		title="Problem solver <coder>"
		subtitle="Computer Systems Engineer (TecNM Campus Laguna). Specialized in Apple platforms focused on iOS. I follow industry best practices, clean architecture, and continuous learning."
		items={[
			{
				text: "10+ years: from UIKit to SwiftUI, adopting Swift Concurrency (async/await).",
			},
			{
				text: "Team player and hands-on leader of small iOS teams.",
			},
			{
				text: "Reliable delivery: testability, strict SPM modularization, and CI/CD.",
			},
			{
				text: "Product-oriented: analytics and observability with Adobe and DataDog.",
			},
		]}
		photoSrc="/hero/taylor_wave.png"
	/>

	<SkillStrip
		skills={[
			{
				icon: "mdi:design",
				title: "Architecture",
				desc: "Clean Architecture, SOLID, TDD, layered boundaries.",
			},
			{
				icon: "mdi:source-branch",
				title: "Modularization",
				desc: "SPM modules, clear boundaries, and defined dependencies.",
			},
			{
				icon: "mdi:gesture-tap-button",
				title: "SwiftUI & Concurrency",
				desc: "From UIKit to SwiftUI; async/await, actors, and isolation.",
			},
			{
				icon: "mdi:chart-box-outline",
				title: "Analytics & Observability",
				desc: "Adobe Analytics and DataDog: events, traces, and alerts.",
			},
			{
				icon: "mdi:cloud-sync-outline",
				title: "CI/CD",
				desc: "GitHub Actions; Xcode Cloud when applicable.",
			},
			{
				icon: "mdi:terminal",
				title: "Git terminal-first",
				desc: "Git workflows; CLI-driven automation.",
			},
		]}
	/>

	<TechBadges
		title="Technologies"
		items={[
			{ icon: "mdi:apple", label: "Apple Platforms" },
			{ icon: "mdi:language-swift", label: "Swift" },
			{ icon: "mdi:gesture-tap-button", label: "SwiftUI" },
			{ icon: "mdi:alpha-u-box", label: "UIKit" },
			{ icon: "mdi:source-branch", label: "SPM" },
			{ icon: "mdi:cloud-sync-outline", label: "CI/CD" },
			{ icon: "mdi:github", label: "GitHub" },
			{ icon: "mdi:git", label: "Git (CLI)" },
			{ icon: "mdi:chart-box-outline", label: "Adobe Analytics" },
			{ icon: "mdi:chart-timeline-variant", label: "DataDog" },
		]}
	/>

	<ProjectsGrid
		projects={[
			{
				title: "OneDarkTheme",
				desc: "One Dark theme for Xcode.",
				tags: ["Swift", "Xcode"],
				href: "https://github.com/jfdoradotr/OneDarkTheme",
			},
			{
				title: "XCSnippets",
				desc: "Xcode snippets via SPM.",
				tags: ["Swift", "Productivity"],
				href: "https://github.com/jfdoradotr/XCSnippets",
			},
			{
				title: "I-VIPER",
				desc: "Template to bootstrap VIPER.",
				tags: ["Makefile", "Architecture"],
				href: "https://github.com/jfdoradotr/I-VIPER",
			},
		]}
	/>

	<PartnersStrip
		title="Affiliates"
		logoSrc="/partners/bms/bms_logo.png"
		ctaHref="/en/affiliates/"
		ctaLabel="See resources"
		desc="Partner of BigMountainStudio: visual, up-to-date resources to learn SwiftUI."
	/>
</BaseLayout>

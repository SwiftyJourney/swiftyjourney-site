---
import BaseLayout from "../../layouts/BaseLayout.astro";
const altHref = "/es/";
---

<BaseLayout
	lang="en"
	altHref={altHref}
	altLang="es"
	title="Swifty Journey — Juan Dorado"
	description="Mexican iOS/Software Engineer. Swift & SwiftUI."
>
	<section class="py-16 md:py-24 text-center">
		<h1 class="text-4xl md:text-6xl font-bold tracking-tight">Hi there 👋</h1>
		<p class="mt-4 text-lg md:text-xl opacity-80">
			I'm <strong>Juan Dorado</strong>, a proudly Mexican 🇲🇽 iOS/Software
			Engineer focused on mobile development.
		</p>
		<div class="mt-8 flex items-center justify-center gap-3">
			<a
				href="#projects"
				class="px-4 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800"
				>See projects</a
			>
			<a
				href="https://blog.swiftyjourney.com"
				class="px-4 py-2 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"
				>Read the blog</a
			>
		</div>
	</section>

	<section id="projects" class="py-10">
		<h2 class="text-2xl font-semibold">Highlights</h2>
		<div class="mt-6 grid gap-6 md:grid-cols-2">
			<!-- Placeholders: reemplaza con tus tarjetas reales -->
			<article
				class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-5"
			>
				<h3 class="font-medium">Ballpark iOS App</h3>
				<p class="opacity-80 mt-1">
					SwiftUI, SPM modules, analytics, CI/CD with Xcode Cloud.
				</p>
			</article>
			<article
				class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-5"
			>
				<h3 class="font-medium">Articles & Talks</h3>
				<p class="opacity-80 mt-1">
					Clean Architecture, testing, Combine, concurrency.
				</p>
			</article>
		</div>
	</section>

	<section class="py-10">
		<h2 class="text-2xl font-semibold">Affiliations</h2>
		<p class="opacity-80 mt-2">
			Partnered with <strong>BigMountainStudio</strong>. Learn SwiftUI with
			visual, up-to-date resources.
			<a class="underline" href="/en/affiliates">See resources</a>.
		</p>
	</section>
</BaseLayout>

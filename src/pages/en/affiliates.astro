---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffiliateCard from "../../components/AffiliateCard.astro";
import { bmsProductsEN, bmsStoreEN } from "../../data/affiliates-en";

const altHref = "/es/afiliados/";

// filtro por categoría (clientless: con query ?cat=bundle|books|course)
const url = new URL(Astro.request.url);
const cat = url.searchParams.get("cat"); // 'bundle' | 'books' | 'course' | null
const products = cat
  ? bmsProductsEN.filter((p) => p.category === cat)
  : bmsProductsEN;
---

<BaseLayout
  lang="en"
  altHref={altHref}
  altLang="es"
  title="Affiliates — Swifty Journey"
  description="BigMountainStudio resources and bundles."
>
  <section class="py-10 md:py-14">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">Affiliates</h1>
    <p class="opacity-80 mt-3 max-w-2xl">
      Curated resources from our partners. When you purchase using these links,
      you support SwiftyJourney at no extra cost to you.
    </p>

    <!-- filtros simples -->
    <div class="mt-6 flex flex-wrap gap-2 text-sm">
      <a
        href="/en/affiliates/"
        class="px-3 py-1 rounded-full border border-zinc-300 dark:border-zinc-700"
        >All</a
      >
      <a href="/en/affiliates/?cat=books" class="px-3 py-1 rounded-full border"
        >Books</a
      >
      <a href="/en/affiliates/?cat=course" class="px-3 py-1 rounded-full border"
        >Courses</a
      >
      <a href="/en/affiliates/?cat=bundle" class="px-3 py-1 rounded-full border"
        >Bundles</a
      >
    </div>

    <h2 class="mt-10 text-xl font-semibold">BigMountainStudio</h2>
    <p class="opacity-80 mt-1">
      Visual, up-to-date approach to learning SwiftUI — highly recommended for
      visual learners.
      <a
        href={bmsStoreEN}
        rel="sponsored noopener"
        target="_blank"
        class="underline">Visit the store</a
      >.
    </p>

    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <AffiliateCard
            title={p.title}
            desc={p.desc}
            image={p.image}
            price={p.price}
            tags={p.tags}
            href={p.link}
          />
        ))
      }
    </div>

    <p class="text-xs opacity-60 mt-8">
      Affiliate disclaimer: some links are affiliate. You pay the same price — a
      small commission may support this site.
    </p>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPortfolio from "../../components/HeroPortfolio.astro";
import ProblemSolver from "../../components/ProblemSolver.astro";
import SkillStrip from "../../components/SkillStrip.astro";
import ProjectsGrid from "../../components/ProjectsGrid.astro";
import TechBadges from "../../components/TechBadges.astro";
import PartnersStrip from "../../components/PartnersStrip.astro";

const altHref = "/en/";
---

<BaseLayout
  lang="es"
  altHref={altHref}
  altLang="en"
  title="Swifty Journey — Juan Dorado"
  description="Ingeniero iOS mexicano. Swift & SwiftUI."
>
  <HeroPortfolio
    title="Ingeniero iOS"
    subtitle="Construyo apps iOS mantenibles y testeables con arquitectura limpia, analítica y CI/CD."
    ctas={[
      { label: "Ver trabajo", href: "#projects" },
      // { label: "Descargar CV", href: "/JuanDorado-CV.pdf", kind: "primary" }, // TODO: Agregar archivo CV
      { label: "Ir al blog", href: "https://blog.swiftyjourney.com/es" },
    ]}
  />

  <ProblemSolver
    title="Problem solver <coder>"
    subtitle="Ingeniero en Sistemas Computacionales (TecNM Campus Laguna). Especializado en plataformas Apple con foco en iOS. Sigo buenas prácticas de la industria, arquitectura limpia y aprendizaje continuo."
    items={[
      {
        text: "10+ años: de UIKit a SwiftUI, adoptando Swift Concurrency (async/await).",
      },
      {
        text: "Trabajo en equipo y liderazgo práctico de equipos iOS pequeños.",
      },
      {
        text: "Entrega confiable: testabilidad, modularización estricta con SPM y CI/CD.",
      },
      {
        text: "Orientado a producto: analítica y observabilidad con Adobe y DataDog.",
      },
    ]}
    photoSrc="/hero/taylor_wave.png"
  />

  <SkillStrip
    skills={[
      {
        icon: "mdi:design",
        title: "Arquitectura",
        desc: "Clean Architecture, SOLID, TDD, límites por capas.",
      },
      {
        icon: "mdi:source-branch",
        title: "Modularización",
        desc: "Módulos SPM, límites claros y dependencias definidas.",
      },
      {
        icon: "mdi:gesture-tap-button",
        title: "SwiftUI & Concurrencia",
        desc: "De UIKit a SwiftUI; async/await, actores y aislamiento.",
      },
      {
        icon: "mdi:chart-box-outline",
        title: "Analytics & Observabilidad",
        desc: "Adobe Analytics y DataDog: eventos, trazas y alertas.",
      },
      {
        icon: "mdi:cloud-sync-outline",
        title: "CI/CD",
        desc: "GitHub Actions; Xcode Cloud cuando aplica.",
      },
      {
        icon: "mdi:terminal",
        title: "Git terminal-first",
        desc: "Flujos Git; automatización vía CLI.",
      },
    ]}
  />

  <TechBadges
    title="Tecnologías"
    items={[
      { icon: "mdi:apple", label: "Apple Platforms" },
      { icon: "mdi:language-swift", label: "Swift" },
      { icon: "mdi:gesture-tap-button", label: "SwiftUI" },
      { icon: "mdi:alpha-u-box", label: "UIKit" },
      { icon: "mdi:source-branch", label: "SPM" },
      { icon: "mdi:cloud-sync-outline", label: "CI/CD" },
      { icon: "mdi:github", label: "GitHub" },
      { icon: "mdi:git", label: "Git (CLI)" },
      { icon: "mdi:chart-box-outline", label: "Adobe Analytics" },
      { icon: "mdi:chart-timeline-variant", label: "DataDog" },
    ]}
  />

  <ProjectsGrid
    projects={[
      {
        title: "OneDarkTheme",
        desc: "Tema One Dark para Xcode.",
        tags: ["Swift", "Xcode"],
        href: "https://github.com/SwiftyJourney/OneDarkTheme",
      },
      {
        title: "XCSnippets",
        desc: "Snippets de Xcode vía SPM.",
        tags: ["Swift", "Productividad"],
        href: "https://github.com/SwiftyJourney/XCSnippets",
      },
      {
        title: "I-VIPER",
        desc: "Plantilla para iniciar proyectos con VIPER.",
        tags: ["Makefile", "Arquitectura"],
        href: "https://github.com/SwiftyJourney/I-VIPER",
      },
    ]}
  />

  <PartnersStrip
    title="Afiliados"
    logoSrc="/partners/bms/bms_logo.png"
    ctaHref="/es/afiliados/"
    ctaLabel="Ver recursos"
    desc="Socio de BigMountainStudio: recursos visuales y actualizados para aprender SwiftUI."
    ,
    disclaimer="Algunos enlaces pueden ser de afiliado — apoyas Swifty Journey sin costo extra para ti."
  />
</BaseLayout>

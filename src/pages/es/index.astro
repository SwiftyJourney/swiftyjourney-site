---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPortfolio from "../../components/HeroPortfolio.astro";
import ProblemSolver from "../../components/ProblemSolver.astro";
import SkillStrip from "../../components/SkillStrip.astro";
import ProjectsGrid from "../../components/ProjectsGrid.astro";
import TechStack from "../../components/TechStack.astro";
import PartnersStrip from "../../components/PartnersStrip.astro";

const altHref = "/es/";
---

<BaseLayout
  lang="en"
  altHref={altHref}
  altLang="es"
  title="Swifty Journey — Juan Dorado"
  description="Mexican iOS/Software Engineer. Swift & SwiftUI."
>
  <HeroPortfolio
    title="Frontend iOS Engineer"
    subtitle="I build maintainable, testable iOS apps with clean architecture, analytics and CI/CD."
    ctas={[
      { label: "See my work", href: "#projects" },
      { label: "Download CV", href: "/JuanDorado-CV.pdf", kind: "primary" },
      { label: "Read the blog", href: "https://blog.swiftyjourney.com" },
    ]}
  />

  <ProblemSolver
    title="Problem solver <coder>"
    subtitle="Ingeniero en Sistemas Computacionales (TecNM Campus Laguna). Especializado en plataformas Apple, con foco en iOS. Aplico buenas prácticas de la industria, arquitectura limpia y aprendizaje continuo."
    items={[
      {
        text: "Experiencia de +10 años: de UIKit a SwiftUI, adoptando Swift Concurrency (async/await).",
      },
      {
        text: "Trabajo en equipo y liderazgo de pequeños equipos iOS orientados a resultados.",
      },
      {
        text: "Entregas confiables: testabilidad, modularización con SPM y CI/CD.",
      },
      {
        text: "Orientado al producto: métricas y observabilidad con Adobe y DataDog.",
      },
    ]}
    photoSrc="/hero/taylor_wave.png"
  />

  <SkillStrip
    skills={[
      {
        icon: "mdi:design",
        title: "Arquitectura",
        desc: "Clean Architecture, SOLID, TDD y separación por capas.",
      },
      {
        icon: "mdi:source-branch",
        title: "Modularización",
        desc: "SPM, boundaries claros y dependencias bien definidas.",
      },
      {
        icon: "mdi:gesture-tap-button",
        title: "SwiftUI & Concurrencia",
        desc: "De UIKit a SwiftUI; async/await, actores y aislamiento.",
      },
      {
        icon: "mdi:chart-box-outline",
        title: "Analytics & Observabilidad",
        desc: "Adobe Analytics, DataDog: eventos, trazas y alertas.",
      },
      {
        icon: "mdi:cloud-sync-outline",
        title: "CI/CD",
        desc: "GitHub Actions y Xcode Cloud cuando aplica.",
      },
      {
        icon: "mdi:terminal",
        title: "Git Terminal‑first",
        desc: "Flujos Git; preferencia por CLI y automatización.",
      },
    ]}
  />

  <TechStack
    title="Tecnologías & enfoque"
    items={[
      {
        icon: "mdi:apple",
        name: "Apple Platforms",
        desc: "iOS como foco principal; experiencia en iPadOS, watchOS y tvOS.",
      },
      {
        icon: "mdi:gesture-tap-button",
        name: "SwiftUI / UIKit",
        desc: "Interfaz moderna con SwiftUI y legado sólido en UIKit.",
      },
      {
        icon: "mdi:language-swift",
        name: "Swift Concurrency",
        desc: "async/await, actores, aislamiento de datos y pruebas.",
      },
      {
        icon: "mdi:source-branch",
        name: "Modularización (SPM)",
        desc: "Boundaries claros, dependencias bien definidas y testabilidad.",
      },
      {
        icon: "mdi:design",
        name: "Arquitectura",
        desc: "Clean Architecture, SOLID, TDD, MVVM, composición.",
      },
      {
        icon: "mdi:cloud-sync-outline",
        name: "CI/CD",
        desc: "GitHub Actions con SRE; Xcode Cloud cuando aplica.",
      },
      {
        icon: "mdi:chart-box-outline",
        name: "Analytics",
        desc: "Adobe Analytics, DataDog: eventos, trazas, alertas.",
      },
      {
        icon: "mdi:git",
        name: "Version Control",
        desc: "Git terminal-first en GitHub/GitLab; flujos de ramificación.",
      },
      {
        icon: "mdi:shield-check",
        name: "Calidad",
        desc: "Unit/UI tests, coverage útil, revisión de PRs, automatización.",
      },
    ]}
  />

  <ProjectsGrid
    projects={[
      {
        title: "OneDarkTheme",
        desc: "One Dark theme for Xcode.",
        tags: ["Swift", "Xcode"],
        href: "https://github.com/jfdoradotr/OneDarkTheme",
      },
      {
        title: "XCSnippets",
        desc: "Xcode snippets via SPM.",
        tags: ["Swift", "Productivity"],
        href: "https://github.com/jfdoradotr/XCSnippets",
      },
      {
        title: "I-VIPER",
        desc: "Template to bootstrap VIPER.",
        tags: ["Makefile", "Architecture"],
        href: "https://github.com/jfdoradotr/I-VIPER",
      },
    ]}
  />

  <PartnersStrip
    title="Afiliados"
    logoSrc="/partners/bms_logo.png"
    ctaHref="TU_LINK_DE_AFILIADO"
    ctaLabel="Ver recursos"
    desc="Socio de BigMountainStudio: recursos visuales y actualizados para aprender SwiftUI."
  />
</BaseLayout>

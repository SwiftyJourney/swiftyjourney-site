---
import BaseLayout from "../../layouts/BaseLayout.astro";
const altHref = "/en/";
---

<BaseLayout
  lang="es"
  altHref={altHref}
  altLang="en"
  title="Swifty Journey — Juan Dorado"
  description="Ingeniero de software iOS, Swift y SwiftUI."
>
  <section class="py-16 md:py-24 text-center">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight">¡Hola! 👋</h1>
    <p class="mt-4 text-lg md:text-xl opacity-80">
      Soy <strong>Juan Dorado</strong>, un orgulloso mexicano 🇲🇽 enfocado en
      desarrollo móvil (iOS).
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <a
        href="#projects"
        class="px-4 py-2 rounded-xl border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800"
        >Ver proyectos</a
      >
      <a
        href="https://blog.swiftyjourney.com"
        class="px-4 py-2 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900"
        >Ir al blog</a
      >
    </div>
  </section>

  <section id="projects" class="py-10">
    <h2 class="text-2xl font-semibold">Destacados</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <article
        class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-5"
      >
        <h3 class="font-medium">Ballpark iOS App</h3>
        <p class="opacity-80 mt-1">
          SwiftUI, módulos SPM, analytics y CI/CD con Xcode Cloud.
        </p>
      </article>
      <article
        class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-5"
      >
        <h3 class="font-medium">Artículos & charlas</h3>
        <p class="opacity-80 mt-1">
          Clean Architecture, pruebas, Combine, concurrencia.
        </p>
      </article>
    </div>
  </section>

  <section class="py-10">
    <h2 class="text-2xl font-semibold">Afiliaciones</h2>
    <p class="opacity-80 mt-2">
      Socio de <strong>BigMountainStudio</strong>. Recursos visuales y
      actualizados para aprender SwiftUI.
      <a class="underline" href="/es/affiliates">Ver recursos</a>.
    </p>
  </section>
</BaseLayout>

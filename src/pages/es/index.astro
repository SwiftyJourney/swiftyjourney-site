---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroPortfolio from "../../components/HeroPortfolio.astro";
import FeaturedArticles from "../../components/FeaturedArticles.astro";
import MiniAbout from "../../components/MiniAbout.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import { featuredArticles } from "../../data/featured-articles";
---

<BaseLayout
  lang="es"
  title="Swifty Journey — Juan Dorado"
  description="Senior iOS Engineer. Swift, SwiftUI, Clean Architecture."
  seoTitle="Juan Dorado — Senior iOS Engineer"
  seoDescription="Construyo apps iOS mantenibles y testeables con Swift y SwiftUI — y escribo sobre lo que aprendo en el camino."
  seoType="profile"
>
  <HeroPortfolio
    titleLead="Domina"
    titleAccent="Swift"
    titleTail="Construye apps iOS reales."
    subtitle="Comparto lo que aprendo tras 11+ años enviando apps iOS — clean architecture, SwiftUI e ingeniería del mundo real, en lenguaje claro."
    primaryCta={{ label: "Leer el blog", href: "https://blog.swiftyjourney.com/es/", external: true }}
    ghostCta={{ label: "Sobre mí", href: "/es/about/" }}
  />

  <FeaturedArticles
    eyebrow="Últimos artículos"
    title="Del blog"
    articles={featuredArticles.es}
    moreLabel="Leer todos los artículos"
    moreHref="https://blog.swiftyjourney.com/es/"
  />

  <MiniAbout
    heading="Hola, soy Juan — Senior iOS Engineer desde México."
    body="11+ años enviando apps iOS, de UIKit a SwiftUI, de proyectos individuales a liderar equipos. Escribo para ayudar a otros ingenieros a razonar los tradeoffs que a mí me hubiera gustado que me mostraran."
    ctaLabel="Más sobre mí"
    ctaHref="/es/about/"
  />

  <FinalCTA
    heading="¿Quieres aprender Swift en serio?"
    body="Escritura clara, opiniones fuertes, código que funciona."
    ctaLabel="Leer el blog"
    ctaHref="https://blog.swiftyjourney.com/es/"
    external
  />
</BaseLayout>

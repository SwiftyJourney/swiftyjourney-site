---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AffiliateCard from "../../components/AffiliateCard.astro";
import { bmsProductsES, bmsStoreES } from "../../data/affiliates-es";

const altHref = "/en/affiliates/";

const url = new URL(Astro.request.url);
const cat = url.searchParams.get("cat");
const products = cat
  ? bmsProductsES.filter((p) => p.category === cat)
  : bmsProductsES;
---

<BaseLayout
  lang="es"
  altHref={altHref}
  altLang="en"
  title="Afiliados — Swifty Journey"
  description="Recursos y bundles de BigMountainStudio."
>
  <section class="py-10 md:py-14">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">Afiliados</h1>
    <p class="opacity-80 mt-3 max-w-2xl">
      Recursos seleccionados de nuestros socios. Al comprar con estos enlaces
      apoyas SwiftyJourney sin costo extra para ti.
    </p>

    <div class="mt-6 flex flex-wrap gap-2 text-sm">
      <a
        href="/es/afiliados/"
        class="px-3 py-1 rounded-full border border-zinc-300 dark:border-zinc-700"
        >Todos</a
      >
      <a href="/es/afiliados/?cat=books" class="px-3 py-1 rounded-full border"
        >Libros</a
      >
      <a href="/es/afiliados/?cat=course" class="px-3 py-1 rounded-full border"
        >Cursos</a
      >
      <a href="/es/afiliados/?cat=bundle" class="px-3 py-1 rounded-full border"
        >Bundles</a
      >
    </div>

    <h2 class="mt-10 text-xl font-semibold">BigMountainStudio</h2>
    <p class="opacity-80 mt-1">
      Método visual y actualizado para aprender SwiftUI — ideal si aprendes
      mejor con recursos visuales.
      <a
        href={bmsStoreES}
        rel="sponsored noopener"
        target="_blank"
        class="underline">Visitar la tienda</a
      >.
    </p>

    <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        products.map((p) => (
          <AffiliateCard
            title={p.title}
            desc={p.desc}
            image={p.image}
            price={p.price}
            tags={p.tags}
            href={p.link}
          />
        ))
      }
    </div>

    <p class="text-xs opacity-60 mt-8">
      Aviso de afiliados: algunos enlaces son de afiliado. Pagas lo mismo — una
      pequeña comisión puede apoyar este sitio.
    </p>
  </section>
</BaseLayout>

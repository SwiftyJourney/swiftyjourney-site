---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import LangToggle from "../components/LangToggle.astro";
import SEO from "../components/SEO.astro";
import { Icon } from "astro-icon/components";
import EDLogo from "../components/EDLogo.astro";
import { createPersonJsonLd, createOrganizationJsonLd, createWebsiteJsonLd } from "../data/seo-data";

const SITE = "https://swiftyjourney.com";

// Props por página
const {
  title = "Swifty Journey",
  description = "iOS • Swift • SwiftUI",
  lang = "en",
  seoTitle,
  seoDescription,
  seoImage,
  seoType = "website",
} = Astro.props;

// Ruta actual (e.g. /en/blog)
const path = Astro.url.pathname || "/";

/** Diccionario de slugs por idioma (puedes agregar más pares) */
const slugMap: Record<"en" | "es", Record<string, string>> = {
  en: {
    // Agrega aquí más mapeos de rutas si necesitas
  },
  es: {
    // Agrega aquí más mapeos de rutas si necesitas
  },
};

/** Traduce el primer segmento de una ruta al otro idioma */
function translateFirstSegment(
  currentLang: "en" | "es",
  otherLang: "en" | "es",
  pathname: string,
) {
  // quita el prefijo /en/ o /es/
  const bare = pathname.replace(/^\/(en|es)\//, "");
  const parts = bare.split("/").filter(Boolean); // ["blog", "sub", ...]

  if (parts.length === 0) {
    return `/${otherLang}/`; // home
  }

  const first = parts[0];
  const mapped = (slugMap[currentLang] && slugMap[currentLang][first]) || first;

  const rebuilt = `/${otherLang}/${[mapped, ...parts.slice(1)].join("/")}`;
  return rebuilt.endsWith("/") ? rebuilt : rebuilt + "/";
}

const isEN = path.startsWith("/en/") || (!path.startsWith("/en/") && !path.startsWith("/es/"));
const isES = path.startsWith("/es/");
const currentLang = isEN ? "en" : "es";
const otherLang = currentLang === "es" ? "en" : "es";

// URLs alternas correctas (prefijo + slug traducido)
const toEn = isEN ? path : translateFirstSegment("es", "en", path);
const toEs = isES ? path : translateFirstSegment("en", "es", path);

// Canonical y hreflang (por ruta actual y su alterna)
const canonical = new URL(path, SITE).toString();
const hrefEn = new URL(toEn, SITE).toString();
const hrefEs = new URL(toEs, SITE).toString();

// Home por idioma (para el logo)
const homeHref = lang === "en" ? "/en/" : "/es/";

// JSON-LD data
const personJsonLd = createPersonJsonLd(lang);
const organizationJsonLd = createOrganizationJsonLd(lang);
const websiteJsonLd = createWebsiteJsonLd(lang);

// Combine all structured data
const combinedJsonLd = {
  "@context": "https://schema.org",
  "@graph": [personJsonLd, organizationJsonLd, websiteJsonLd]
};
---

<html lang={lang} class="min-h-full" transition:animate="fade">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    
    <!-- SEO Component with enhanced meta tags -->
    <SEO 
      title={seoTitle || title}
      description={seoDescription || description}
      canonical={canonical}
      image={seoImage}
      type={seoType}
      lang={lang}
      jsonLd={combinedJsonLd}
    />

    <!-- Hreflang (por ruta actual) -->
    <link rel="alternate" href={hrefEn} hreflang="en" />
    <link rel="alternate" href={hrefEs} hreflang="es-mx" />
    <link rel="alternate" href={SITE + "/"} hreflang="x-default" />

    <link rel="icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    
    <!-- Performance optimizations -->
    <link rel="dns-prefetch" href="//github.com">
    <link rel="dns-prefetch" href="//x.com">
    <link rel="dns-prefetch" href="//linkedin.com">
    <link rel="preconnect" href="https://iosacademy.essentialdeveloper.com">
    
    <!-- Prefetch critical routes -->
    <link rel="prefetch" href={lang === 'en' ? '/es/' : '/en/'}>
    
    <!-- Resource hints for better performance -->
    <link rel="preload" href="/logo-light.svg" as="image" type="image/svg+xml">
    <link rel="preload" href="/logo-dark.svg" as="image" type="image/svg+xml">
    
    <!-- Critical CSS inline for faster LCP -->
    <style>
      /* Critical above-the-fold styles */
      body { margin: 0; padding: 0; }
      .header { position: sticky; top: 0; z-index: 50; }
      .hero { padding: 4rem 1rem; text-align: center; }
      .hero h1 { font-size: 3rem; font-weight: bold; margin: 0; }
      @media (min-width: 768px) {
        .hero { padding: 6rem 1rem; }
        .hero h1 { font-size: 4.5rem; }
      }
    </style>

    <!-- View Transitions styles -->
    <style>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.3s;
      }
      
      ::view-transition-old(root) {
        animation-name: fade-out;
      }
      
      ::view-transition-new(root) {
        animation-name: fade-in;
      }
      
      @keyframes fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }
      
      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    </style>

    <!-- Service Worker registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(registration => {
              console.log('SW registered: ', registration);
            })
            .catch(registrationError => {
              console.log('SW registration failed: ', registrationError);
            });
        });
      }
    </script>

    <!-- Evita "flash" de tema -->
    <script is:inline>
      (function () {
        const key = "theme";
        const saved = localStorage.getItem(key);
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const useDark = (saved ?? (prefersDark ? "dark" : "light")) === "dark";
        if (useDark) document.documentElement.classList.add("dark");
      })();
    </script>
  </head>

  <body
    class="bg-white text-zinc-900 dark:bg-zinc-900 dark:text-zinc-100 antialiased"
  >
    <!-- Header sticky + blur -->
    <header
      class="header sticky top-0 z-50 backdrop-blur supports-[backdrop-filter]:bg-white/70 dark:supports-[backdrop-filter]:bg-zinc-900/70"
    >
      <div
        class="max-w-6xl mx-auto px-4 py-3 md:py-4 flex items-center justify-between"
      >
        <a
          href={homeHref}
          class="flex items-center gap-2"
          aria-label="Swifty Journey — Home"
          transition:persist="logo"
        >
          <!-- Logo light/dark (mismo archivo para ambos idiomas) -->
          <img
            src="/logo-light.svg"
            alt="Swifty Journey"
            width="192"
            height="48"
            class="h-12 w-auto block dark:hidden"
          />
          <img
            src="/logo-dark.svg"
            alt="Swifty Journey"
            width="192"
            height="48"
            class="h-12 w-auto hidden dark:block"
          />
        </a>

        <nav class="flex items-center gap-2" transition:persist="navigation">
          <LangToggle lang={lang} toEn={toEn} toEs={toEs} />
          <div class="ml-2">
            <ThemeToggle />
          </div>
        </nav>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4">
      <slot />
    </main>

    <footer class="max-w-6xl mx-auto px-4 py-10 opacity-80">
      <div class="flex flex-col items-center gap-4">
        <div class="flex gap-4 text-2xl">
          <a
            href="https://github.com/swiftyjourney"
            target="_blank"
            rel="noopener me"
            class="hover:opacity-100 opacity-80"
          >
            <Icon name="mdi:github" />
          </a>
          <a
            href="https://x.com/jfdoradotr"
            target="_blank"
            rel="noopener me"
            class="hover:opacity-100 opacity-80"
          >
            <Icon name="mdi:twitter" />
          </a>
          <a
            href="https://linkedin.com/in/juanfranciscodoradotorres"
            target="_blank"
            rel="noopener me"
            class="hover:opacity-100 opacity-80"
          >
            <Icon name="mdi:linkedin" />
          </a>
        </div>
        <a
          href="https://iosacademy.essentialdeveloper.com/p/ios-lead-essentials/"
          target="_blank"
          rel="noopener"
          class="inline-flex rounded-full p-[1px] bg-gradient-to-r from-orange-500 via-amber-500 to-red-500 hover:opacity-100 opacity-80"
        >
          <span
            class="inline-flex items-center gap-2 rounded-full px-3 py-1 bg-zinc-900 text-white text-xs leading-none"
          >
            <EDLogo class="h-4 w-auto" />
            <span>Moderator — iOS Lead Essentials (2022)</span>
          </span>
        </a>
        <p class="text-sm">
          © {new Date().getFullYear()} Swifty Journey — Created by Juan F. Dorado.
        </p>
        <p class="text-xs opacity-60">
          Built with Astro, Tailwind, and Swift-inspired minimalism.
        </p>
      </div>
    </footer>
  </body>
</html>

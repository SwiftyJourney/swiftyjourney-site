---
import { Icon } from "astro-icon/components";

type Area = { icon: string; title: string; desc: string };
type Metric = { value: string; label: string };
type Props = {
  title: string;
  subtitle: string;
  areas: Area[];
  metrics?: Metric[];
  ctaLabel: string;
  ctaHref: string;
};
const { title, subtitle, areas, metrics, ctaLabel, ctaHref } = Astro.props;
---

<section id="connect" class="py-16 md:py-24">
  <div class="max-w-3xl mx-auto text-center mb-10">
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">{title}</h2>
    <p class="opacity-70 mt-2 text-lg">{subtitle}</p>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {areas.map((a) => (
      <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6 transition-all duration-300 hover:border-orange-500/30 hover:shadow-md">
        <Icon name={a.icon} class="text-2xl" />
        <h3 class="mt-3 font-medium">{a.title}</h3>
        <p class="opacity-80 mt-1">{a.desc}</p>
      </div>
    ))}
  </div>

  {metrics && metrics.length > 0 && (
    <div class="mt-10 flex flex-wrap justify-center gap-10">
      {metrics.map((m) => (
        <div class="text-center">
          <p class="text-3xl md:text-4xl font-bold text-orange-500">{m.value}</p>
          <p class="text-sm opacity-70 mt-1">{m.label}</p>
        </div>
      ))}
    </div>
  )}

  <div class="mt-10 text-center">
    <a
      href={ctaHref}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-medium rounded-xl shadow-lg shadow-orange-500/30 hover:shadow-xl hover:scale-105 transition-all duration-300"
    >
      {ctaLabel}
    </a>
  </div>
</section>

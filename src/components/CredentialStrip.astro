---
import EDLogo from "./EDLogo.astro";

type Credential = {
  logoComponent?: string;
  logoSrc?: string;
  program: string;
  role?: string;
  year: string;
  href?: string;
};
type Props = {
  title?: string;
  credentials: Credential[];
};
const { title, credentials } = Astro.props;
---

<section class="py-12 md:py-16">
  {title && (
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-center mb-8">
      {title}
    </h2>
  )}
  <div class="flex flex-wrap justify-center gap-6">
    {credentials.map((c) => {
      const inner = (
        <div class="credential-card flex items-center gap-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 px-6 py-4 transition-all duration-300 hover:border-orange-500/30 hover:shadow-md">
          {c.logoComponent === "EDLogo" ? (
            <EDLogo class="h-8 w-auto shrink-0" />
          ) : c.logoSrc ? (
            <img src={c.logoSrc} alt={c.program} class="h-8 w-auto shrink-0" />
          ) : null}
          <div>
            <p class="font-medium">{c.program}</p>
            <p class="text-sm opacity-70">
              {c.role ? `${c.role} · ${c.year}` : c.year}
            </p>
          </div>
        </div>
      );

      return c.href ? (
        <a href={c.href} target="_blank" rel="noopener" class="no-underline">
          {inner}
        </a>
      ) : (
        inner
      );
    })}
  </div>
</section>

---
type Props = {
  code: 404 | 500;
  lang: "en" | "es";
};

const { code, lang } = Astro.props;

const T = {
  en: {
    title404: "404 — Page Not Found",
    title500: "500 — Something went wrong",
    msg404:
      "Looks like you've taken a wrong turn on your journey. Let's get you back on track.",
    msg500: "An unexpected error occurred. Please try again, or go back home.",
    goEN: "Go to English Home",
    goES: "Go to Spanish Home",
    back: "Back",
  },
  es: {
    title404: "404 — Página no encontrada",
    title500: "500 — Algo salió mal",
    msg404:
      "Parece que tomaste un desvío en tu viaje. Vamos a volver al camino.",
    msg500: "Ocurrió un error inesperado. Intenta de nuevo o vuelve al inicio.",
    goEN: "Ir a Home en Inglés",
    goES: "Ir a Inicio en Español",
    back: "Regresar",
  },
}[lang];

const title = code === 404 ? T.title404 : T.title500;
const msg = code === 404 ? T.msg404 : T.msg500;
---

<section class="py-24 flex flex-col items-center text-center">
  <div class="text-7xl select-none">🧭</div>
  <h1 class="mt-8 text-4xl md:text-5xl font-semibold tracking-tight">{title}</h1>
  <p class="mt-4 text-lg text-text-muted max-w-[46ch]">{msg}</p>

  <div class="mt-10 flex flex-wrap gap-3 justify-center">
    <a
      href="/en/"
      class="px-5 py-2.5 rounded-md border border-border hover:border-coral-500 hover:text-coral-500 transition-colors"
    >
      {T.goEN}
    </a>
    <a
      href="/es/"
      class="px-5 py-2.5 rounded-md bg-coral-500 text-white hover:bg-coral-600 transition-colors"
    >
      {T.goES}
    </a>
    <button
      class="px-5 py-2.5 rounded-md border border-border hover:border-coral-500 hover:text-coral-500 transition-colors"
      onclick="history.back()"
      aria-label="Go back"
    >
      {T.back}
    </button>
  </div>
</section>

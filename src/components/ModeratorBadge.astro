---
import EDLogo from "./EDLogo.astro";
import OptimizedImage from './OptimizedImage.astro';

type Props = {
  href?: string;
  logoSrc?: string;
  text?: string;
  useInlineLogo?: boolean;
};
const {
  href = "https://iosacademy.essentialdeveloper.com/p/ios-lead-essentials/",
  logoSrc = "/partners/ed/logo.svg",
  text = "Moderador — iOS Lead Essentials (2022)",
  useInlineLogo = true,
} = Astro.props as Props;
---

<span
  class="inline-flex rounded-full p-[1px] bg-gradient-to-r from-orange-500 via-amber-500 to-red-500"
>
  <a
    href={href}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-full px-3 py-1 bg-zinc-900 text-white text-xs md:text-sm leading-none"
  >
    {
      useInlineLogo ? (
        <EDLogo class="h-4 w-auto" />
      ) : (
        <OptimizedImage 
          src={logoSrc} 
          alt="Essential Developer" 
          width={40}
          height={16}
          class="h-4 w-auto" 
          loading="lazy"
        />
      )
    }
    <span>{text}</span>
  </a>
</span>

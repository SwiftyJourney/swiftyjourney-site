---
import { Icon } from "astro-icon/components";
type Item = { text: string };
type Props = {
  title: string;
  subtitle: string;
  items: Item[];
  photoSrc: string;
};
const { title, subtitle, items, photoSrc } = Astro.props;
---

<section class="py-16 md:py-24">
  <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight">{title}</h2>
      <p class="opacity-80 mt-2">{subtitle}</p>

      <ul class="mt-6 space-y-3">
        {
          items.map((i) => (
            <li class="flex items-start gap-3">
              <Icon name="mdi:check-circle-outline" class="mt-1" />
              <span class="opacity-90">{i.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="flex justify-center">
      <img
        src={photoSrc}
        alt="Juan Dorado"
        class="w-64 md:w-80 rounded-2xl shadow-sm"
      />
    </div>
  </div>
</section>

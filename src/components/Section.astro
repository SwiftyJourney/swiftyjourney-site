---
type Props = {
  id?: string;
  title?: string;
  subtitle?: string;
  center?: boolean;
  class?: string;
};
const { id, title, subtitle, center = false, class: klass = "" } = Astro.props;
---

<section id={id} class={`py-16 md:py-24 ${klass}`}>
  {
    title && (
      <header class={`mb-8 ${center ? "text-center" : ""}`}>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight">
          {title}
        </h2>
        {subtitle && <p class="opacity-70 mt-1">{subtitle}</p>}
      </header>
    )
  }
  <slot />
</section>

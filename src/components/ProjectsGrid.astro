---
type Project = { title: string; desc: string; tags?: string[]; href: string };
type Props = { title?: string; projects: Project[] };
const { title = "My {dev} projects", projects } = Astro.props;
---

<section class="py-16 md:py-24" id="projects">
  <h2 class="text-3xl font-semibold tracking-tight text-center">{title}</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {
      projects.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener"
          class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-5 hover:shadow-sm transition"
        >
          <h3 class="font-medium">{p.title}</h3>
          <p class="opacity-80 mt-1">{p.desc}</p>
          {p.tags?.length && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {p.tags.map((t) => (
                <li class="text-xs px-2 py-1 rounded-full border border-zinc-200 dark:border-zinc-700">
                  {t}
                </li>
              ))}
            </ul>
          )}
        </a>
      ))
    }
  </div>
</section>

---
type Props = {
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
};
const { title, subtitle, ctaLabel, ctaHref } = Astro.props;
---

<section class="py-16 md:py-20">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">
      {title}
    </h2>
    <p class="opacity-80 text-lg mb-8">
      {subtitle}
    </p>
    <a
      href={ctaHref}
      class="inline-flex items-center gap-2 px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-medium rounded-lg transition-colors"
    >
      {ctaLabel}
    </a>
  </div>
</section>

---

type Props = {
  title: string;
  subtitle: string;
  ctas: { label: string; href: string; kind?: "primary" | "ghost" }[];
};
const { title, subtitle, ctas } = Astro.props;
---

<section class="py-16 md:py-24 text-center">
  <h1 class="text-5xl md:text-7xl font-bold tracking-tight">{title}</h1>
  <p class="mt-4 text-lg md:text-xl opacity-80 max-w-2xl mx-auto">{subtitle}</p>

  <div class="mt-4 flex items-center justify-center gap-3">
    <slot name="meta" />
  </div>

  <div class="mt-8 flex items-center justify-center gap-3 flex-wrap">
    {
      ctas.map(({ label, href, kind = "ghost" }) => (
        <a
          href={href}
          class={`inline-flex items-center gap-2 px-6 py-3 font-medium rounded-lg transition-colors
                 ${kind === "primary"
                   ? "bg-orange-500 hover:bg-orange-600 text-white shadow-lg shadow-orange-500/30"
                   : "border border-zinc-300 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800"}`}
        >
          {label}
        </a>
      ))
    }
  </div>

  <!-- Decorativo: taylor coding -->
  <div class="relative mt-12 flex items-center justify-center" transition:name="hero-image">
    <img 
      src="/hero/taylor_coding.png"
      alt="Taylor Swift coding illustration"
      width="320"
      height="320"
      class="w-64 md:w-80 opacity-80"
      loading="lazy"
    />
  </div>
</section>

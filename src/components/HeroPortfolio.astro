---
import Button from "./Button.astro";

type Props = {
  titleLead: string;
  titleAccent: string;
  titleTail: string;
  subtitle: string;
  primaryCta: { label: string; href: string; external?: boolean };
  ghostCta: { label: string; href: string };
  imageSrc?: string;
  imageAlt?: string;
};

const {
  titleLead,
  titleAccent,
  titleTail,
  subtitle,
  primaryCta,
  ghostCta,
  imageSrc = "/hero/taylor_coding.png",
  imageAlt = "Swifty Journey bird illustration",
} = Astro.props;
---

<section class="py-20 md:py-32 text-center">
  <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-text leading-[1.05]">
    {titleLead}{" "}
    <span class="italic text-accent">{titleAccent}</span>.
    <br class="hidden md:block" />
    {titleTail}
  </h1>

  <p class="mt-6 text-lg md:text-xl text-text-muted max-w-2xl mx-auto leading-relaxed">
    {subtitle}
  </p>

  <div class="mt-10 flex items-center justify-center gap-3 flex-wrap">
    <Button href={primaryCta.href} kind="primary" size="lg" external={primaryCta.external}>
      {primaryCta.label}
    </Button>
    <Button href={ghostCta.href} kind="ghost" size="lg">
      {ghostCta.label} →
    </Button>
  </div>

  <div class="relative mt-16 md:mt-20 flex items-center justify-center" transition:name="hero-image">
    <div class="hero-halo" aria-hidden="true"></div>
    <img
      src={imageSrc}
      alt={imageAlt}
      width="320"
      height="320"
      class="relative w-56 md:w-72 lg:w-80"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <style>
    .hero-halo {
      position: absolute;
      inset: 50% 50% auto auto;
      transform: translate(50%, -50%);
      width: 28rem;
      height: 28rem;
      border-radius: 9999px;
      background: radial-gradient(
        closest-side,
        rgba(249, 115, 99, 0.28) 0%,
        rgba(236, 105, 91, 0.10) 45%,
        rgba(236, 105, 91, 0) 75%
      );
      pointer-events: none;
      z-index: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-halo { opacity: 0.6; }
    }
  </style>
</section>

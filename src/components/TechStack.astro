---
import { Icon } from "astro-icon/components";
type Item = { icon: string; name: string; desc: string };
type Props = { title?: string; items: Item[] };
const { title = "Tech stack", items } = Astro.props;
---

<section class="py-12 md:py-16">
  {
    title && (
      <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-8 text-center">
        {title}
      </h2>
    )
  }
  <div class="grid gap-6 md:grid-cols-3">
    {
      items.map((s) => (
        <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6">
          <div class="flex items-center gap-3">
            <Icon name={s.icon} class="text-2xl" />
            <h3 class="font-medium">{s.name}</h3>
          </div>
          <p class="opacity-80 mt-2">{s.desc}</p>
        </div>
      ))
    }
  </div>
</section>

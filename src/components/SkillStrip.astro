---
import { Icon } from "astro-icon/components";
type Skill = { icon: string; title: string; desc: string };
type Props = { skills: Skill[] };
const { skills } = Astro.props;
---

<section class="py-12 md:py-16">
  <div class="grid gap-6 md:grid-cols-3">
    {
      skills.map((s) => (
        <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6">
          <Icon name={s.icon} class="text-2xl" />
          <h3 class="mt-3 font-medium">{s.title}</h3>
          <p class="opacity-80 mt-1">{s.desc}</p>
        </div>
      ))
    }
  </div>
</section>

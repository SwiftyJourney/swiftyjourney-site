---
type Props = {
  title: string;
  desc: string;
  tech?: string[];
  href?: string; // link a GitHub o case study
};
const { title, desc, tech = [], href = "#" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="block rounded-2xl border border-zinc-200 dark:border-zinc-800 p-5 hover:shadow-sm transition"
>
  <h3 class="font-medium">{title}</h3>
  <p class="opacity-80 mt-1">{desc}</p>
  {
    tech.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tech.map((t) => (
          <li class="text-xs px-2 py-1 rounded-full border border-zinc-200 dark:border-zinc-700">
            {t}
          </li>
        ))}
      </ul>
    )
  }
</a>

---
type Props = {
  title: string;
  desc: string;
  tech?: string[];
  href?: string; // link a GitHub o case study
};
const { title, desc, tech = [], href = "#" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class="project-card block rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6 transition-all duration-300"
>
  <h3 class="font-semibold text-lg">{title}</h3>
  <p class="opacity-80 mt-2">{desc}</p>
  {
    tech.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tech.map((t) => (
          <li class="text-xs px-3 py-1.5 rounded-full border border-zinc-200 dark:border-zinc-700">
            {t}
          </li>
        ))}
      </ul>
    )
  }
</a>

<style>
  .project-card {
    position: relative;
    background: white;
  }

  :global(.dark) .project-card {
    background: rgb(24 24 27);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
    border-color: rgb(249 115 22 / 0.3);
  }

  :global(.dark) .project-card:hover {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
    border-color: rgb(249 115 22 / 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }
</style>

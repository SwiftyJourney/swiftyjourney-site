---
import GroundedNav from "./GroundedNav.astro";
import { groundedContent, GROUNDED_SUPPORT_EMAIL, type Lang } from "../../data/grounded-content";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const c = groundedContent[lang].support;
const base = `/${lang}/apps/grounded`;
---

<GroundedNav lang={lang} current="support" />

<section class="py-16 md:py-24">
  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent mb-5">
    {c.eyebrow}
  </p>
  <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-text leading-[1.05]">
    {c.heading}
  </h1>
  <p class="mt-8 text-xl text-text-muted leading-relaxed max-w-3xl">
    {c.lede}
  </p>
</section>

<section class="pb-16 md:pb-24 max-w-3xl">
  <div class="rounded-2xl border border-border bg-surface p-6 md:p-8">
    <h2 class="text-2xl font-semibold tracking-tight text-text">{c.contactHeading}</h2>
    <p class="mt-3 text-text-muted leading-relaxed">{c.contactBody}</p>
    <p class="mt-5">
      <a
        href={`mailto:${GROUNDED_SUPPORT_EMAIL}?subject=Grounded`}
        class="text-lg font-medium text-accent hover:text-accent-hover underline-offset-4 hover:underline break-all"
      >
        {GROUNDED_SUPPORT_EMAIL}
      </a>
    </p>
  </div>
</section>

<section class="py-16 md:py-24 border-t border-border">
  <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-text">
    {c.faqHeading}
  </h2>
  <div class="mt-8 max-w-3xl divide-y divide-border border-y border-border">
    {c.faqs.map((faq) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-lg font-medium text-text">
          <span>{faq.question}</span>
          <span aria-hidden="true" class="mt-1 text-text-subtle transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-text-muted leading-relaxed">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>

<section class="py-16 border-t border-border flex flex-wrap gap-6">
  <a href={`${base}/privacy/`} class="text-text hover:text-accent underline-offset-4 hover:underline">
    {c.privacyLink}
  </a>
  <a href={`${base}/`} class="text-text hover:text-accent underline-offset-4 hover:underline">
    {c.appLink}
  </a>
</section>

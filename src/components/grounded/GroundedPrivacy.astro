---
import GroundedNav from "./GroundedNav.astro";
import {
  groundedContent,
  GROUNDED_PRIVACY_UPDATED,
  GROUNDED_SUPPORT_EMAIL,
  type Lang,
} from "../../data/grounded-content";

type Props = {
  lang: Lang;
};

const { lang } = Astro.props;
const c = groundedContent[lang].privacy;
const base = `/${lang}/apps/grounded`;
---

<GroundedNav lang={lang} current="privacy" />

<article class="py-16 md:py-24 max-w-3xl">
  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-accent mb-5">
    {c.eyebrow}
  </p>
  <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-text leading-[1.05]">
    {c.heading}
  </h1>
  <p class="mt-6 text-sm text-text-subtle">
    {c.updatedLabel}: <time datetime={GROUNDED_PRIVACY_UPDATED}>{GROUNDED_PRIVACY_UPDATED}</time>
  </p>
  <p class="mt-8 text-xl text-text-muted leading-relaxed">
    {c.lede}
  </p>

  {c.sections.map((section) => (
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-text">{section.heading}</h2>
      {section.paragraphs.map((paragraph) => (
        <p class="mt-3 text-text-muted leading-relaxed">{paragraph}</p>
      ))}
    </section>
  ))}

  <section class="mt-12 pt-10 border-t border-border">
    <h2 class="text-2xl font-semibold tracking-tight text-text">{c.contactHeading}</h2>
    <p class="mt-3 text-text-muted leading-relaxed">
      {c.contactBody}{" "}
      <a
        href={`mailto:${GROUNDED_SUPPORT_EMAIL}?subject=Grounded`}
        class="text-accent hover:text-accent-hover underline-offset-4 hover:underline break-all"
      >
        {GROUNDED_SUPPORT_EMAIL}
      </a>
    </p>
    <p class="mt-6">
      <a href={`${base}/support/`} class="text-text hover:text-accent underline-offset-4 hover:underline">
        {c.supportLink}
      </a>
    </p>
  </section>
</article>

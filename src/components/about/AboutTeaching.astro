---
import SectionHeading from "../SectionHeading.astro";
import type { Credential } from "../../data/about-content";

type Props = {
  eyebrow: string;
  title: string;
  moderator: { role: string; program: string; org: string; period: string; href: string };
  academyHeading: string;
  credentials: Credential[];
};

const { eyebrow, title, moderator, academyHeading, credentials } = Astro.props;
---

<section class="py-20 md:py-28 border-t border-border">
  <SectionHeading eyebrow={eyebrow} title={title} />

  <div class="mt-14 space-y-10">
    <div>
      <a
        href={moderator.href}
        target="_blank"
        rel="noopener"
        class="inline-flex flex-col gap-1 group"
      >
        <span class="text-sm text-text-subtle uppercase tracking-wider">
          {moderator.role} · {moderator.period}
        </span>
        <span class="text-2xl md:text-3xl font-semibold text-text tracking-tight group-hover:text-accent transition-colors">
          {moderator.program}
        </span>
        <span class="text-base text-text-muted">{moderator.org}</span>
      </a>
    </div>

    <div>
      <h3 class="text-xl md:text-2xl font-semibold text-text tracking-tight mb-4">
        {academyHeading}
      </h3>
      <ul class="space-y-3">
        {credentials.map((cred) => (
          <li>
            <a
              href={cred.href}
              target="_blank"
              rel="noopener"
              class="group flex flex-col md:flex-row md:items-baseline md:gap-4"
            >
              <span class="text-lg text-text group-hover:text-accent transition-colors">
                · {cred.program}
              </span>
              <span class="text-sm text-text-subtle md:ml-auto">
                {cred.year}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

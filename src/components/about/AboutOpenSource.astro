---
import SectionHeading from "../SectionHeading.astro";
import type { Project } from "../../data/about-content";

type Props = {
  eyebrow: string;
  title: string;
  projects: Project[];
  as?: "h2" | "h3";
};

const { eyebrow, title, projects, as = "h2" } = Astro.props;
---

<section class="py-20 md:py-28 border-t border-border">
  <SectionHeading eyebrow={eyebrow} title={title} as={as} />

  <ul class="mt-12 border-t border-border">
    {projects.map((project) => (
      <li class="border-b border-border">
        <a
          href={project.href}
          target="_blank"
          rel="noopener"
          class="group flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8 py-8 md:py-10 -mx-4 px-4 rounded-md hover:bg-surface-alt/40 transition-colors"
        >
          <div class="flex-1">
            <h3 class="text-2xl md:text-3xl font-semibold text-text tracking-tight group-hover:text-coral-500 transition-colors">
              {project.title}
            </h3>
            <p class="mt-2 text-base text-text-muted leading-relaxed">
              {project.desc}
            </p>
          </div>
          <div class="flex items-baseline gap-4">
            <span class="text-sm text-text-subtle hidden md:inline">
              {project.tags.join(" · ")}
            </span>
            <span class="text-coral-500 text-xl transition-transform group-hover:translate-x-1" aria-hidden="true">
              →
            </span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

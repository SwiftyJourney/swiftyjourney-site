---
import { Icon } from "astro-icon/components";
type Item = { icon: string; label: string };
type Props = { title?: string; items: Item[] };
const { title = "Technologies", items } = Astro.props;
---

<section class="py-10">
  {
    title && (
      <h2 class="text-xl md:text-2xl font-semibold tracking-tight mb-4">
        {title}
      </h2>
    )
  }
  <div class="flex flex-wrap gap-2">
    {
      items.map((t) => (
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-zinc-200 dark:border-zinc-800 text-sm transition-all duration-300 hover:border-orange-500/50 hover:bg-orange-500/10">
          <Icon name={t.icon} class="text-base" />
          {t.label}
        </span>
      ))
    }
  </div>
</section>
